#!/bin/bash
#SBATCH --time=08:00:00
#SBATCH --job-name=SpurSpLiCE_CQT_graphs
#SBATCH --array=0-5%2
#SBATCH --mem=40G
#SBATCH --mail-type=END,FAIL
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=5
#SBATCH --nodes=1
#SBATCH --gres=gpu:v100:1
#SBATCH --partition=informatik-mind
#SBATCH --gpu_cmode=shared
#SBATCH --output=./output/CRPv2/slurm-%x_%A_%a.out
#SBATCH --error=./output/CRPv2/slurm-%x_%A_%a.err

set -euo pipefail

PROJECT_DIR="${PROJECT_DIR:-/home/xar68reb/Spur_SpLiCE}"
SEED="0"
PREPARE_ONLY="true"
CRP_FORCE_REBUILD="false"
CQT_NULL_TRIALS="32"

case "${SLURM_ARRAY_TASK_ID}" in
    0)
        RELATIONAL_GRAPH_VARIANT="current"
        CQT_MIN_QUOTIENT_EFFICACY="0.04"; CQT_DINO_DAMAGE_QUANTILE="0.60"
        CQT_MAX_FACTORS="8"; CQT_MIN_GROUP_SIZE="1"
        CQT_TEXT_SIMILARITY_THRESHOLD="0.80"; CQT_COACTIVATION_THRESHOLD="0.35"
        ;;
    1)
        RELATIONAL_GRAPH_VARIANT="q001_d060_wide"
        CQT_MIN_QUOTIENT_EFFICACY="0.01"; CQT_DINO_DAMAGE_QUANTILE="0.60"
        CQT_MAX_FACTORS="16"; CQT_MIN_GROUP_SIZE="1"
        CQT_TEXT_SIMILARITY_THRESHOLD="0.80"; CQT_COACTIVATION_THRESHOLD="0.35"
        ;;
    2)
        RELATIONAL_GRAPH_VARIANT="q001_d065_wide"
        CQT_MIN_QUOTIENT_EFFICACY="0.01"; CQT_DINO_DAMAGE_QUANTILE="0.65"
        CQT_MAX_FACTORS="16"; CQT_MIN_GROUP_SIZE="1"
        CQT_TEXT_SIMILARITY_THRESHOLD="0.80"; CQT_COACTIVATION_THRESHOLD="0.35"
        ;;
    3)
        RELATIONAL_GRAPH_VARIANT="q002_d065_wide"
        CQT_MIN_QUOTIENT_EFFICACY="0.02"; CQT_DINO_DAMAGE_QUANTILE="0.65"
        CQT_MAX_FACTORS="16"; CQT_MIN_GROUP_SIZE="1"
        CQT_TEXT_SIMILARITY_THRESHOLD="0.80"; CQT_COACTIVATION_THRESHOLD="0.35"
        ;;
    4)
        RELATIONAL_GRAPH_VARIANT="q001_d060_grouped"
        CQT_MIN_QUOTIENT_EFFICACY="0.01"; CQT_DINO_DAMAGE_QUANTILE="0.60"
        CQT_MAX_FACTORS="16"; CQT_MIN_GROUP_SIZE="2"
        CQT_TEXT_SIMILARITY_THRESHOLD="0.70"; CQT_COACTIVATION_THRESHOLD="0.20"
        ;;
    5)
        RELATIONAL_GRAPH_VARIANT="q002_d065_grouped"
        CQT_MIN_QUOTIENT_EFFICACY="0.02"; CQT_DINO_DAMAGE_QUANTILE="0.65"
        CQT_MAX_FACTORS="16"; CQT_MIN_GROUP_SIZE="2"
        CQT_TEXT_SIMILARITY_THRESHOLD="0.70"; CQT_COACTIVATION_THRESHOLD="0.20"
        ;;
    *) echo "Unknown array task ${SLURM_ARRAY_TASK_ID}" >&2; exit 2 ;;
esac

source "${PROJECT_DIR}/scripts/train_cqt.sbatch"

