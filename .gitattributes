# Cluster shell scripts must keep LF endings: a CR byte makes bash fail with
# "$'\r': command not found" on the Slurm nodes, even when the file is edited on Windows.
*.sbatch text eol=lf
*.sh     text eol=lf

# JSON artifacts are hashed (graph fingerprints, SHA-256 attestations, storage-identity fixtures),
# so their bytes stay LF on every platform.
*.json text eol=lf
