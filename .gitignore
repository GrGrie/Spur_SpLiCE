# Python bytecode, environments, builds, and test/tool caches
__pycache__/
*.py[cod]
*.egg-info/
.Python
.cache/
.hypothesis/
.mypy_cache/
.nox/
.pytest_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
build/
dist/
site/
.venv/
venv/
env/
ENV/
__pypackages__/

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# Secrets and local configuration
.env
.env.*
!.env.example
*.local

# Native/build products
*.so
*.dll
*.dylib
*.egg

# Machine-local datasets and runtime directories
/datasets/
/output/
/save/
/tmp/
/wandb/
/scripts/output/

# Model checkpoints and tensor/feature caches never enter Git. The small,
# immutable OpenCLIP mean below is a source fixture and is the sole exception.
*.pt
*.pth
*.ckpt
*.safetensors
*.wandb
!data/means/*.pt

# Runtime logs
*.log
*.out
*.err

# LaTeX intermediates
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.synctex.gz
crpv2_skeleton.tex

# Documentation is synchronized across machines. Temporary editor and generated
# files remain covered by the global rules above.

# outputs/ is a Git allowlist. Only compact, inspectable result records in the
# four canonical trees are synchronized.
/outputs/**
!/outputs/README.md
!/outputs/SLURM/
!/outputs/SLURM/.gitkeep

!/outputs/seeds/
!/outputs/seeds/**/
!/outputs/seeds/**/*.json
!/outputs/seeds/**/*.jsonl
!/outputs/seeds/**/*.csv
!/outputs/seeds/**/*.yaml
!/outputs/seeds/**/*.yml
!/outputs/seeds/**/*.md
!/outputs/seeds/**/*.txt
!/outputs/seeds/**/.gitkeep

!/outputs/reports/
!/outputs/reports/**/
!/outputs/reports/**/*.json
!/outputs/reports/**/*.jsonl
!/outputs/reports/**/*.csv
!/outputs/reports/**/*.yaml
!/outputs/reports/**/*.yml
!/outputs/reports/**/*.md
!/outputs/reports/**/*.txt
!/outputs/reports/**/.gitkeep

!/outputs/shared/
!/outputs/shared/**/
!/outputs/shared/**/*.json
!/outputs/shared/**/*.jsonl
!/outputs/shared/**/*.csv
!/outputs/shared/**/*.yaml
!/outputs/shared/**/*.yml
!/outputs/shared/**/*.md
!/outputs/shared/**/*.txt
!/outputs/shared/**/.gitkeep
/outputs/shared/legacy/**

!/outputs/reference/
!/outputs/reference/**/
!/outputs/reference/**/*.json
!/outputs/reference/**/*.jsonl
!/outputs/reference/**/*.csv
!/outputs/reference/**/*.yaml
!/outputs/reference/**/*.yml
!/outputs/reference/**/*.md
!/outputs/reference/**/*.txt
!/outputs/reference/**/.gitkeep

# Local review and maintenance workspaces
/.cleanup-review/
/.paper-tools/
/.test-deps/
