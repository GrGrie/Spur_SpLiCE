{
  "name": "waterbirds_cospro",
  "description": "Canonical five-arm CoSpRo comparison.",
  "seeds": [1, 2, 3, 4],
  "flags": ["use_wandb", "keep_checkpoints"],
  "common": {
    "dataset": "waterbirds",
    "data_folder": "${DATA_FOLDER}",
    "model": "resnet18_large",
    "epochs": 500,
    "batch_size": 128,
    "num_workers": 4,
    "learning_rate": 0.01,
    "optimizer": "SGD",
    "temp": 0.05,
    "weight_decay": 0.0001,
    "momentum": 0.9,
    "ssl_crop_min": 0.2,
    "cospro_temperature": 0.25,
    "cospro_start_epoch": 10,
    "cospro_warmup_epochs": 10,
    "linear_probe_solver": "logistic",
    "linear_probe_l2": 0.001,
    "linear_probe_tolerance": 0.000001,
    "linear_probe_max_epochs": 200,
    "train_set_linear_layer": "ds_train",
    "linear_eval_split": "val",
    "linear_probe_mode": "periodic",
    "linear_probe_freq": 25,
    "linear_spurious_probe": true,
    "delete_checkpoints_after_training": true,
    "retain_probe_artifacts_every": 0,
    "wandb_name": "CoSpRo",
    "wandb_group": "waterbirds_cospro",
    "wandb_tags": "canonical,waterbirds,cospro"
  },
  "locked_test": {
    "description": "Predeclared held-out evaluation: one group-balanced logistic probe at SSL epoch 500.",
    "flags": ["final_test"],
    "args": {
      "linear_eval_split": "test",
      "linear_probe_mode": "final",
      "linear_probe_freq": 0
    }
  },
  "arms": {
    "simclr": {"args": {"splice_mode": "none", "splice_weight": 0}},
    "cospro_sampler_only": {"args": {"splice_mode": "cospro_relational", "splice_weight": 0, "cospro_teacher_graph": "{artifacts}/shared/waterbirds/graphs/crp_graph.json"}},
    "raw_clip_sampler_only": {"args": {"splice_mode": "cospro_relational", "splice_weight": 0, "cospro_teacher_graph": "{artifacts}/shared/waterbirds/graphs/raw_clip_graph.json"}},
    "raw_clip_kl": {"args": {"splice_mode": "cospro_relational", "splice_weight": 0.5, "cospro_teacher_graph": "{artifacts}/shared/waterbirds/graphs/raw_clip_graph.json"}},
    "cospro": {"args": {"splice_mode": "cospro_relational", "splice_weight": 0.5, "cospro_teacher_graph": "{artifacts}/shared/waterbirds/graphs/crp_graph.json"}}
  }
}
