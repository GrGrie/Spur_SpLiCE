{
  "name": "waterbirds_crp",
  "description": "Canonical five-arm SpLiCE-CRP comparison.",
  "seeds": [1, 2, 3, 4],
  "flags": ["use_wandb", "keep_checkpoints"],
  "common": {
    "dataset": "waterbirds",
    "data_folder": "${DATA_FOLDER}",
    "model": "resnet18_large",
    "epochs": 500,
    "batch_size": 128,
    "num_workers": 4,
    "learning_rate": 0.01,
    "optimizer": "SGD",
    "temp": 0.05,
    "weight_decay": 0.0001,
    "momentum": 0.9,
    "ssl_crop_min": 0.2,
    "crp_temperature": 0.25,
    "crp_start_epoch": 10,
    "crp_warmup_epochs": 10,
    "linear_probe_solver": "logistic",
    "linear_probe_l2": 0.001,
    "linear_probe_tolerance": 0.000001,
    "linear_probe_max_epochs": 200,
    "train_set_linear_layer": "ds_train",
    "linear_eval_split": "val",
    "linear_probe_mode": "periodic",
    "linear_probe_freq": 25,
    "linear_spurious_probe": true,
    "delete_checkpoints_after_training": true,
    "retain_probe_artifacts_every": 100,
    "wandb_name": "Spur_SpLiCE",
    "wandb_group": "waterbirds_crp",
    "wandb_tags": "canonical,waterbirds,crp"
  },
  "arms": {
    "simclr": {"args": {"splice_mode": "none", "splice_weight": 0}},
    "crp_sampler_only": {"args": {"splice_mode": "crp_relational", "splice_weight": 0, "crp_teacher_graph": "{project}/outputs/shared/waterbirds/graphs/crp_graph.json"}},
    "raw_clip_sampler_only": {"args": {"splice_mode": "crp_relational", "splice_weight": 0, "crp_teacher_graph": "{project}/outputs/shared/waterbirds/graphs/raw_clip_graph.json"}},
    "raw_clip_kl": {"args": {"splice_mode": "crp_relational", "splice_weight": 0.5, "crp_teacher_graph": "{project}/outputs/shared/waterbirds/graphs/raw_clip_graph.json"}},
    "splice_crp_kl": {"args": {"splice_mode": "crp_relational", "splice_weight": 0.5, "crp_teacher_graph": "{project}/outputs/shared/waterbirds/graphs/crp_graph.json"}}
  }
}
